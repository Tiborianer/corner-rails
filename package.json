{
  "name": "corner-rails",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:pages": "vite build --config vite.pages.config.ts",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "assets:generate": "node scripts/generate-train-assets.mjs",
    "assets:railjet-lab": "node scripts/process-railjet-lab-sprites.mjs && node scripts/generate-railjet-vector-assets.mjs && node scripts/generate-railjet-lab-assets.mjs",
    "assets:railjet-blender": "'/Applications/Blender.app/Contents/MacOS/Blender' --background --factory-startup --disable-autoexec --python-exit-code 1 --python scripts/blender/generate_railjet_classic.py && '/Applications/Blender.app/Contents/MacOS/Blender' --background --factory-startup --disable-autoexec --python-exit-code 1 --python scripts/blender/generate_railjet_nextgen.py && node scripts/optimize-blender-railjet-assets.mjs",
    "assets:db-regional-express-blender": "'/Applications/Blender.app/Contents/MacOS/Blender' --background --factory-startup --disable-autoexec --python-exit-code 1 --python scripts/blender/generate_db_regional_express.py && node scripts/optimize-db-regional-express-assets.mjs",
    "assets:nightjet-blender": "'/Applications/Blender.app/Contents/MacOS/Blender' --background --factory-startup --disable-autoexec --python-exit-code 1 --python scripts/blender/generate_nightjet_new_generation.py && node scripts/optimize-nightjet-new-generation-assets.mjs",
    "qa:railjet-mobile": "node scripts/capture-railjet-lab.mjs",
    "qa:railjet-blender": "'/Applications/Blender.app/Contents/MacOS/Blender' --background assets/blender/railjet-classic/railjet-classic-master.blend --disable-autoexec --python-exit-code 1 --python scripts/blender/render_railjet_reviews.py -- classic && '/Applications/Blender.app/Contents/MacOS/Blender' --background assets/blender/railjet-nextgen/railjet-nextgen-master.blend --disable-autoexec --python-exit-code 1 --python scripts/blender/render_railjet_reviews.py -- nextgen",
    "qa:db-regional-express-blender": "'/Applications/Blender.app/Contents/MacOS/Blender' --background assets/blender/db-regional-express/db-regional-express-master.blend --disable-autoexec --python-exit-code 1 --python scripts/blender/render_db_regional_express_reviews.py",
    "qa:nightjet-blender": "'/Applications/Blender.app/Contents/MacOS/Blender' --background assets/blender/nightjet-new-generation/nightjet-new-generation-master.blend --disable-autoexec --python-exit-code 1 --python scripts/blender/render_nightjet_new_generation_reviews.py",
    "qa:railjet-contact-sheets": "node scripts/build-railjet-contact-sheets.mjs",
    "test": "vitest run --config vitest.config.ts && npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-pages --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "sharp": "^0.34.5",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "vitest": "^4.1.10",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
